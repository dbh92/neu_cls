# Python virtual environment (recreate with: python -m venv .venv && pip install -r requirements.txt)
.venv/

# Python bytecode cache
__pycache__/
*.pyc

# Generated by scripts (recreate with prepare_data.py / train.py / export_onnx/export.py)
data/
outputs/
outputs_*/
export_onnx/model.onnx
export_onnx/model.json

# IDE settings (PyCharm), specific to each machine
.idea/
